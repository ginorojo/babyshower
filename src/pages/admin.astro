---
import '../styles/global.css';
import Admin from '../components/Admin';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<!-- Que no aparezca en Google ni en buscadores -->
		<meta name="robots" content="noindex, nofollow" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Panel de regalos</title>

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Forum&family=Pinyon+Script&display=swap" rel="stylesheet">
	</head>
	<body class="antialiased min-h-screen bg-[#f4f1ea] text-[#826c4f]">
		<!-- client:only porque el panel depende de la sesión guardada en el
		     navegador: no tiene sentido pre-renderizarlo en el build. -->
		<Admin client:only="react" />

		<style is:global>
			body { font-family: 'Forum', serif; }
			.font-script {
				font-family: 'Pinyon Script', cursive;
				-webkit-text-stroke: 0.6px currentColor;
			}
		</style>
	</body>
</html>

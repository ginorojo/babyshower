---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;

// Lo que se ve al compartir el enlace por WhatsApp o redes.
const descripcion = 'Acompáñanos a celebrar la llegada de Thiago. Sábado 10 de octubre, 16:00 hrs · Capilla Barrio Brillador, La Serena.';
// Absolutas a la fuerza: las vistas previas no entienden rutas relativas.
const imagen = new URL('/og.jpg', Astro.site).href;
const direccion = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={descripcion} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="canonical" href={direccion} />

		<!-- Vista previa al compartir el enlace (WhatsApp, Facebook, Instagram) -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Baby Shower de Thiago" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={descripcion} />
		<meta property="og:url" content={direccion} />
		<meta property="og:image" content={imagen} />
		<meta property="og:image:secure_url" content={imagen} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Invitación al Baby Shower de Thiago" />
		<meta property="og:locale" content="es_CL" />

		<!-- Lo mismo para X/Twitter, que usa sus propias etiquetas -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={descripcion} />
		<meta name="twitter:image" content={imagen} />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Forum&family=Pinyon+Script&display=swap" rel="stylesheet">
	</head>
	<body class="antialiased min-h-screen overflow-x-hidden text-[#826c4f]">
		<div class="fixed inset-0 -z-10 w-screen h-screen overflow-hidden bg-[#e8f1f8]">
			<!-- Imagen estirada y muy borrosa para rellenar los espacios en desktop -->
			<img 
				src="/poo6.png" 
				alt="" 
				class="absolute inset-0 w-full h-full object-cover object-center hidden md:block blur-2xl scale-110 "
			/>
			
			<!-- Imagen principal (cover en móvil, contain nítido en desktop, ligeramente agrandada) -->
			<img 
				src="/poo7.jpg" 
				alt="Fondo Baby Shower" 
				class="absolute inset-0 w-full h-full object-cover md:object-contain md:scale-[1.15] md:origin-center object-center drop-shadow-2xl opacity-30 transition-all duration-500"
				onerror="this.src='https://images.unsplash.com/photo-1519689680058-324335c77eba?q=80&w=2070&auto=format&fit=crop'"
			/>

			<!-- Capa oscura sutil eliminada o súper sutil para que el texto resalte pero sin oscurecer mucho -->
			<div class="absolute inset-0 bg-slate-900/5 pointer-events-none"></div>
		</div>

		<main class="relative z-10 w-full min-h-screen">
			<slot />
		</main>

		<style is:global>
			/* Configuraciones globales adicionales */
			body {
				font-family: 'Forum', serif;
			}
			
			.font-script {
				font-family: 'Pinyon Script', cursive;
				-webkit-text-stroke: 0.6px currentColor;
			}
			
			/* Ocultar barra de navegación de forma estética */
			.no-scrollbar::-webkit-scrollbar {
				display: none;
			}
			.no-scrollbar {
				-ms-overflow-style: none;
				scrollbar-width: none;
			}
		</style>
	</body>
</html>
